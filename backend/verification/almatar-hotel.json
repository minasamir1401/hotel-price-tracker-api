    "hotelBasicData": {
      "name": "فندق إم الدانة مكة من ميلينيوم",
      "slogan": "في الروضة بمدينة مكة",
      "style": {
        "name": "إقامة فاخرة",
        "icon": null
      },
      "starRating": 4,
      "propertyType": "فندق",
      "countryCode": "SA",
      "countryName": "المملكة العربية السعودية",
      "cityName": "مكة المكرمة",
      "address": "طريق الأمير ماجد بن عبد العزيز",
      "chainName": "Millennium",
      "chain": "MU",
      "descriptions": [
        {
          "line": 1,
          "title": "الموقع",
          "paragraph": "لدى الإقامة في فندق إم الدانة مكة من ميلينيوم في مكة (الروضة)، ستكون على بُعد 10 دقائق بالسيارة من الكعبة والمسجد الحرام.  الإقامة في هذا الفندق تضعك على بُعد ٧ كم من أبراج الساعة و٠٫٨ كم من مسجد الشيخ عبد العزيز بن باز."
        },
        {
          "line": 2,
          "title": "تناول الطعام",
          "paragraph": "استمتع بوجبة في مطعم Al Dana Restaurant أو بتناول المأكولات الخفيفة في الكافيتيريا. كما يتم تقديم خدمة الغرف (خلال ساعات محدودة) في منشأة فندقية. يتم تقديم بوفيه فطور يوميًا من 6:30 صباحا إلى 10:30 صباحًا مقابل رسم إضافي."
        },
        {
          "line": 3,
          "title": "الغرف",
          "paragraph": "اشعر وكأنك في منزلك عند الإقامة في واحدة من 611 غرفة ضيافة بديكورات فريدة لكل منها، يتوفر بها ثلاجات وتلفزيونات بشاشة مسطحة. يُتاح لك اتصال لاسلكي بالإنترنت مجانًا لتبقى على اتصال دائمًا، بالإضافة إلى قنوات فضائية من أجل متعتك. تضم الحمامات تجهيزات دش ومستلزمات مجانية للعناية الشخصية وبيديه. تشتمل وسائل الراحة المتاحة على هواتف، بالإضافة إلى خزنات ومكاتب."
        },
        {
          "line": 4,
          "title": "وسائل الراحة",
          "paragraph": "تمتع بوسائل الراحة المتاحة في هذه المنشأة، ومنها اتصال لاسلكي مجاني بالإنترنت وخدمات الاستعلامات والإرشاد وقاعة رقص."
        },
        {
          "line": 5,
          "title": "وسائل الراحة للأعمال",
          "paragraph": "تضم وسائل الرائحة المميزة مركز لرجال الأعمال مفتوح 24 ساعة وخدمة سريعة لإنهاء إجراءات المغادرة وخدمة الغسيل/التنظيف الجاف. يتاح مواقف سيارات مجانية قائمة على الخدمة الذاتية داخل موقع المنشأة."
        },
        {
          "line": 6,
          "title": "مواصفات العقار",
          "paragraph": "عدد الغرف - 611"
        },
        {
          "line": 7,
          "title": "تقييمات هيئة السياحة الوطنية",
          "paragraph": "حصلت هذه المنشأة على تصنيف النجوم الرسمي الخاص بها من Saudi Ministry of Tourism."
        },
        {
          "line": 8,
          "title": "اللغات التي يمكن لموظفينا مساعدتك بها",
          "paragraph": "الأردية, الألمانية, الإنجليزية, العربية, الفرنسية, الهندية"
        },
        {
          "line": 9,
          "title": "أنواع الدفع في العقار",
          "paragraph": "أمريكان إكسبريس, بطاقة MasterCard, فيزا, نقدًا, لا تُقبل بطاقات الخصم"
        },
        {
          "line": 10,
          "title": "تعليمات تسجيل الوصول",
          "paragraph": "قد يتم تطبيق رسوم على إقامة شخص إضافي، وتختلف تلك الرسوم تبعًا لسياسة المنشأة. قد يلزم تقديم إثبات شخصية به صورة وصادر عن جهة حكومية، بالإضافة إلى تقديم بطاقة ائتمان عند تسجيل الوصول لتغطية أي رسوم نثرية. تخضع الطلبات الخاصة لمدى التوفر وقت تسجيل الوصول، وقد تستلزم سداد رسوم إضافية، ولا يمكن ضمان تلبية الطلبات الخاصة.. يجب على النزلاء التواصل مع هذه المنشأة مُسبقا لحجز مواقف سيارات ضمن المنشأة. تقبل هذه المنشأة الفندقية السداد باستخدام بطاقات الائتمان والدفع النقدي. تشمل ميزات الأمن والسلامة في هذه المنشأة الفندقية كاشف لغاز أول أكسيد الكربون، وطفّاية حريق، وكاشف دخان، ونظام أمان، وحقيبة إسعافات أولية، وسور حماية للنوافذ. يُرجى الانتباه إلى أن المعايير الثقافية وسياسات النزلاء قد تختلف باختلاف الدولة وباختلاف المنشأة. وقد تمّ تقديم السياسات المُدرجة من قِبَل المنشأة.الحد الأدنى لعمر تسجيل الوصول هو 18."
        },
        {
          "line": 11,
          "title": "تعليمات خاصة لتسجيل الوصول",
          "paragraph": "سيتم الترحيب بالنزلاء عند وصولهم المنشأة الفندقية من قِبَل طاقم مكتب الاستقبال.قد تتم ترجمة المعلومات المقدمة من قبل المنشأة الفندقية باستخدام أدوات الترجمة الآلية. الحد الأدنى لعمر تسجيل الوصول هو: 18."
        },
        {
          "line": 12,
          "title": "إضافات اختيارية",
          "paragraph": "رسوم فطور بوفيه: تبلغ تقريبًا SAR 35 للبالغين، وSAR 17.50 للأطفال. خدمة تسجيل الوصول المُتأخّر متوفرة مقابل رسم (تخضع الخدمة لمدى التوفر). رسوم السرير القابل للطي: 100.0 SAR في الليلة.   القائمة الموضحة أعلاه قد لا تكون شاملة. فالرسوم ومبالغ التأمين قد لا تشمل الضريبة كما قد تخضع للتغيير."
        },
        {
          "line": 13,
          "title": "سياسة الحيوانات الأليفة",
          "paragraph": "غير مسموح باصطحاب الحيوانات الأليفة, لا يُسمح باصطحاب حيوانات الخدمة"
        },
        {
          "line": 14,
          "title": "ما تحتاج إلى معرفته",
          "paragraph": "قد تفرض القوانين المحلية قيوداً على النزلاء غير المتزوجين تمنعهم من مشاركة الغرف. ويتحمل النزلاء مسؤولية حمل دليل على الزواج في حالة ما إذا طلبته المنشأة السياحية.  يجب على المترافقين من الجنسين الذين يرغبون في مشاركة الغرفة أن يقدموا دليلاً على الزواج. لا يسمح بتواجد أشخاص آخرين في الغرف بخلاف النزلاء المسجلين لدى المنشأة.  تتاح لدى المنشأة غرف متصلة/متجاورة حسب التوفر، ويمكن للنزلاء طلب الحصول عليها عن طريق بالاتصال بالمنشأة مباشرة بالاستعانة ببيانات الاتصال الموجودة في تأكيد الحجز.  غير مسموح بالحيوانات الأليفة في هذه المنشأة السياحية، بما يشمل الحيوانات المدربة على أغراض مساعدة أصحابها. تسري قيود داخل مواقف السيارات تتعلّق بارتفاع المركبات يتوفر تسجيل الوصول عن بعد وتسجيل المغادرة عن بعد."
        },
        {
          "line": 15,
          "title": "السجل العقاري",
          "paragraph": "رقم تسجيل/ترخيص الإقامة: 10006701"
        }
      ],
