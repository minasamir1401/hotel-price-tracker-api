# Environment configuration for Dokploy / Docker deployment
PORT=5000
NODE_ENV=production

# Normally leave empty: the backend acquires and renews a public web session.
# Optional server-only token override; rejected overrides fall back to a fresh session.
ALMOSAFER_API_TOKEN=
# Default for hotel names/IDs. Hotel links retain their www/global domain.
ALMOSAFER_ORIGIN=https://www.almosafer.com
# Browser-first scraping keeps bootstrap, cookies and price requests in one context.
# Supported transports: scrapingant, browser, curl, native.
# When using scrapingant, specify one or more comma-separated API keys for automatic round-robin rotation.
SCRAPINGANT_API_KEYS=
# Optional remote browser WebSocket endpoint (e.g. cloud CDP or browser container).
# Example format: wss://USERNAME:PASSWORD@remote-browser-host:port
ALMOSAFER_BROWSER_WS_ENDPOINT=
# Attempt direct price requests with the guest session; 0 retains browser-only traffic.
ALMOSAFER_DIRECT_AFTER_BOOTSTRAP=1
# Direct guest-session HTTP transport: curl (browser TLS/HTTP2) or native.
ALMOSAFER_HANDOFF_HTTP_TRANSPORT=curl
# Optional first-party origin for Browser API; www/global only. Blank preserves the input host.
ALMOSAFER_BROWSER_ORIGIN=
ALMOSAFER_HTTP_TRANSPORT=scrapingant
ALMOSAFER_BROWSER_FALLBACK=1
# Docker provides Xvfb for a full browser. Set to 1 outside Docker without a display.
ALMOSAFER_BROWSER_HEADLESS=0
# Optional fixed outbound proxy, e.g. http://user:password@host:port.
# Keep private; URL-encode credentials. Both browser and curl use this explicitly.
ALMOSAFER_PROXY_URL=
# Docker default; on Windows use the installed Python executable with http-requirements.txt.
ALMOSAFER_PYTHON=/opt/almosafer-http/bin/python

# Booking Android app identification (server only; required to enable Booking)
# Provision from the authorized local APK inspection. Never commit these values.
BOOKING_APP_AUTHORIZATION=
BOOKING_APP_SIGNATURE_SALT=
BOOKING_APP_VERSION=67.4.0.11
BOOKING_APP_DEVICE_ID=

# Optional actual Booking account session, provisioned server-side only.
# App identification above does not authenticate a traveller account.
# Never send this value to the frontend or commit it. No local OTP/Genius spoofing.
BOOKING_AUTH_TOKEN=
# Optional known expiry in ISO 8601 UTC. Expired sessions fail without guest fallback.
BOOKING_AUTH_EXPIRES_AT=
# Protect personal account quotes. A random site-owner key of at least 32 characters.
# This is separate from Booking credentials; exchange it for an HttpOnly site session.
BOOKING_ACCOUNT_ACCESS_KEY=
# Optional exact frontend origin if the reverse proxy changes the Host header.
BOOKING_SITE_ORIGIN=
# auto uses a supplied session, otherwise guest. account requires a real session.
BOOKING_RATE_MODE=auto

# Port mappings on host (when running directly with docker compose)
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Backend service address accessible to frontend container
BACKEND_URL=http://backend:5000
